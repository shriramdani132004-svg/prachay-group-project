# PSPL Expense Voucher Management System - Environment Configuration Template
# Copy this file to .env and fill in actual values. NEVER commit .env to version control.

# Application Environment
NODE_ENV=development

# Frontend (Vite Dev Server)
CLIENT_PORT=5173
CLIENT_ORIGIN=http://localhost:5173

# Backend (Express API Server)
PORT=5000
API_PREFIX=/api/v1

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pspl_vouchers

# Authentication & Session
JWT_SECRET=replace-with-high-entropy-64-char-secret-in-production
JWT_EXPIRES_IN=8h
COOKIE_NAME=pspl_session
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# File Uploads
UPLOAD_DIR=./uploads/signatures
MAX_FILE_SIZE_MB=2

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug