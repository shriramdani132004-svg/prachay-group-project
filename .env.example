# PSPL Expense Voucher Management System - Environment Configuration Template
# Copy this file to .env and fill in actual values. NEVER commit .env to version control.
#
# The backend workspace has its own complete template: server/.env.example

# Application Environment
NODE_ENV=development

# Frontend (Vite Dev Server)
CLIENT_PORT=5173
CLIENT_ORIGIN=http://localhost:5173

# Backend (Express API Server)
PORT=3000
API_PREFIX=/api/v1

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# The bundled docker-compose.dev.yml runs PostgreSQL on 127.0.0.1:5433 to avoid
# colliding with any native PostgreSQL on the default port 5432.
# Placeholder only - use your own local development credentials.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/pspl_voucher_dev?schema=public

# CORS (comma-separated allow-list of permitted browser origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Private signature vault - NEVER served publicly, never committed
SIGNATURE_STORAGE_DIR=./storage/signatures
MAX_SIGNATURE_FILE_SIZE_BYTES=2097152

# Logging
LOG_LEVEL=info

# Trust N reverse-proxy hops for client IPs (0 = none)
TRUST_PROXY_HOPS=0

# Rate limiting (per IP): login attempts and baseline API requests per window
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_API_MAX=300

# ==============================================================================
# Session authentication (Phase 4) - REQUIRED by the backend.
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Placeholders are rejected in every environment. NEVER commit real values.
# Full documentation: server/.env.example
# ==============================================================================
JWT_SECRET=replace-with-high-entropy-64-char-secret-in-production
JWT_ISSUER=pspl-voucher-api
JWT_AUDIENCE=pspl-voucher-portal
JWT_TTL_SECONDS=1800

# Cookie name/Secure/SameSite/Path are derived from NODE_ENV (HttpOnly always;
# "__Host-pspl_session" + Secure in production, "pspl_session" locally).

# Local demo provisioning (development only; refused in production).
# npm run auth:provision-demo requires DEMO_AUTH_ENABLED=true plus one
# independent >= 12-character password per seeded @pspl.test account.
DEMO_AUTH_ENABLED=false
# DEMO_EMPLOYEE_1_PASSWORD=
# DEMO_EMPLOYEE_2_PASSWORD=
# DEMO_DIRECTOR_PASSWORD=
# DEMO_ACCOUNTS_PASSWORD=