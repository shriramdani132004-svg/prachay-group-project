# ==============================================================================
# PSPL Expense Voucher Management System - Backend Environment Template
# Copy to server/.env and fill in real values. NEVER commit a filled .env file.
# All values below are placeholders / local development defaults.
# ==============================================================================

# Runtime environment: development | test | production
NODE_ENV=development

# API server port (frontend dev server uses 5173)
PORT=3000

# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# The bundled docker-compose.dev.yml runs PostgreSQL on 127.0.0.1:5433 to
# avoid colliding with any native PostgreSQL on the default port 5432.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5433/pspl_voucher_dev?schema=public"

# Comma-separated list of browser origins permitted by CORS (variable name is
# CORS_ORIGINS - a wildcard is rejected because credentials are enabled).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Number of reverse-proxy hops to trust for client IPs (0 = none).
TRUST_PROXY_HOPS=0

# Private signature vault directory, relative to the server/ workspace.
# Files here are NEVER served publicly and are ignored by Git.
SIGNATURE_STORAGE_DIR=./storage/signatures

# Maximum accepted signature file size in bytes (2 MB).
MAX_SIGNATURE_FILE_SIZE_BYTES=2097152

# Rate limiting (per IP): login attempts and baseline API requests per window.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_API_MAX=300

# ==============================================================================
# Session authentication (Phase 4) - REQUIRED for the backend to boot.
# ==============================================================================
# High-entropy secret (>= 32 bytes) used to sign HS256 JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Placeholder values are rejected in EVERY environment; production refuses to
# start with a placeholder. NEVER commit the real value.
JWT_SECRET=replace-with-high-entropy-64-char-secret-in-production

# JWT issuer/audience claims (validated on every request) and session lifetime.
JWT_ISSUER=pspl-voucher-api
JWT_AUDIENCE=pspl-voucher-portal
JWT_TTL_SECONDS=1800

# Cookie attributes are DERIVED from NODE_ENV (not configured here):
#   development/test -> cookie "pspl_session",  Secure off (local HTTP)
#   production       -> cookie "__Host-pspl_session", Secure on, Path=/, no Domain
# Always HttpOnly, SameSite=Lax.

# ==============================================================================
# Local demo account provisioning (optional, development only).
# ==============================================================================
# The backend refuses to start in production if this is true. The provisioning
# command (npm run auth:provision-demo) additionally refuses to run unless this
# is explicitly "true" AND every password below is independently supplied with
# at least 12 characters. There is no universal default password.
DEMO_AUTH_ENABLED=false
# DEMO_EMPLOYEE_1_PASSWORD=
# DEMO_EMPLOYEE_2_PASSWORD=
# DEMO_DIRECTOR_PASSWORD=
# DEMO_ACCOUNTS_PASSWORD=